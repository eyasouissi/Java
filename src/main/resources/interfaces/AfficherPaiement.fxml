<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.AfficherPaiement"
            prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #f0f2f7;">

    <!-- Header Section (similar to Twig template header) -->
    <top>
        <HBox style="-fx-background-color: #fff; -fx-padding: 10 20; -fx-border-color: #e9edf4; -fx-border-width: 0 0 1 0; -fx-spacing: 15;" alignment="CENTER_LEFT">
            <!-- Logo -->
            <Label text="Mentor" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #007bff;"/>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Menu -->
            <HBox spacing="25" alignment="CENTER">
                <Label text="Dashboard" style="-fx-font-size: 14px; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>

                <Label text="Courses" style="-fx-font-size: 14px; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>

                <Label text="Forum" style="-fx-font-size: 14px; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>

                <Label text="Events" style="-fx-font-size: 14px; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>

                <Label text="Groups" style="-fx-font-size: 14px; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>

                <Label text="Pricing" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #007bff; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Header right section -->
            <HBox spacing="15" alignment="CENTER">
                <Button style="-fx-background-color: transparent;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button style="-fx-background-color: transparent;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <Button style="-fx-background-color: transparent;">
                    <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                            <Image url="/images/tel.png"/>
                        </ImageView>
                    </graphic>
                </Button>

                <ImageView fitHeight="32" fitWidth="32" style="-fx-cursor: hand;">
                    <Image url="/images/tel.png"/>
                </ImageView>
            </HBox>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox style="-fx-padding: 20 30;">
            <!-- Breadcrumb or Title -->
            <Label text="Liste des Paiements" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1c273c; -fx-padding: 0 0 20 0;"/>

            <!-- Navigation Tabs -->
            <HBox style="-fx-background-color: #fff; -fx-padding: 0 20; -fx-border-color: #e9edf4; -fx-border-width: 1; -fx-border-radius: 5;">
                <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-tab-min-width: 120px;">
                    <tabs>
                        <Tab text="Offres">
                            <content>
                                <!-- Empty content - just for placeholder -->
                                <Region/>
                            </content>
                        </Tab>
                        <Tab text="Paiements" style="-fx-background-color: #007bff;">
                            <content>
                                <!-- Empty content - just for placeholder -->
                                <Region/>
                            </content>
                        </Tab>
                        <Tab text="Rapports">
                            <content>
                                <!-- Empty content - just for placeholder -->
                                <Region/>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>
            </HBox>

            <!-- Main Content Card -->
            <VBox style="-fx-background-color: #fff; -fx-padding: 20; -fx-border-color: #e9edf4; -fx-border-width: 1; -fx-border-radius: 5; -fx-spacing: 20; -fx-margin: 20 0 0 0;">
                <!-- Search & Sort Bar -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Rechercher :" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <TextField fx:id="searchField" promptText="Entrez un nom d'utilisateur" prefWidth="250"
                               style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e5ec; -fx-border-radius: 4px; -fx-padding: 7;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Trier par :" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="sortComboBox" promptText="Choisir une option" prefWidth="200"
                              style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e5ec; -fx-border-radius: 4px;"/>
                </HBox>

                <!-- Table -->
                <TableView fx:id="tablePaiements" prefHeight="400.0" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #fff; -fx-border-color: #e9edf4; -fx-border-radius: 4px;">
                    <columns>
                        <TableColumn fx:id="colUser" text="Utilisateur" prefWidth="220"/>
                        <TableColumn fx:id="colOffre" text="Offre" prefWidth="250"/>
                        <TableColumn fx:id="colDate" text="Date de Paiement" prefWidth="200"/>
                        <TableColumn fx:id="colAction" text="Action" prefWidth="180"/>
                    </columns>
                </TableView>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button fx:id="btnVoirStatistiques" text="Voir les Statistiques"
                            style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20; -fx-border-radius: 4px;"
                            onAction="#allerVersStatistiques">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16">
                                <Image url="/images/tel.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="btnExporterPDF" text="Exporter en PDF"
                            style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20; -fx-border-radius: 4px;"
                            onAction="#exporterPDF">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16">
                                <Image url="/images/tel.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                    <Button fx:id="btnRetourOffres" text="Retour aux Offres"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 20; -fx-border-radius: 4px;"
                            onAction="#allerVersOffres">
                        <graphic>
                            <ImageView fitHeight="16" fitWidth="16">
                                <Image url="/images/tel.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Footer if needed -->
    <bottom>
        <HBox style="-fx-background-color: #fff; -fx-padding: 15; -fx-border-color: #e9edf4; -fx-border-width: 1 0 0 0;" alignment="CENTER">
            <Label text="© 2025 Mentor. All Rights Reserved." style="-fx-text-fill: #7987a1; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>