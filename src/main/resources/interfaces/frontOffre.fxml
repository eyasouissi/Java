<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.frontOffre"
            style="-fx-background-color: #f3e8ff;">
    <VBox layoutX="50.0" layoutY="30.0" spacing="20" prefWidth="900"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          alignment="TOP_CENTER">
        <Label text="Nos Offres"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #4b0082;" />
        <Label text="Choisissez l'abonnement qui vous convient et profitez de nos services exclusifs"
               style="-fx-font-size: 18px; -fx-font-weight: normal; -fx-text-fill: #4b0082;" />
        <HBox fx:id="offersContainer" spacing="20" alignment="CENTER"
              style="-fx-padding: 20px;" />
    </VBox>
</AnchorPane>
