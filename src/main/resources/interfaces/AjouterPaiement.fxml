<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.AjouterPaiement"
            stylesheets="@/css/style.css"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: #f3e8ff;">

    <!-- Header -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header-bar" style="-fx-padding: 10;">
            <Label text="🏠 Mentor" styleClass="header-title" />
            <Button text="Home" onAction="#goHome" styleClass="header-button"/>
            <Button text="Offers" onAction="#goOffres" styleClass="header-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="profileBtn" text="Profile" styleClass="btn-getstarted"/>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
            <Label text="💳 Offer Payment" styleClass="section-title"/>
            <Label fx:id="offreLabel" styleClass="paiement-label"/>
            <Label fx:id="prixLabel" styleClass="paiement-subtitle"/>
            <Label fx:id="userLabel" styleClass="paiement-label" text="Utilisateur: "/>


            <DatePicker fx:id="datePaiementPicker" promptText="Payment date"
                        prefWidth="300" styleClass="custom-field"/>

            <Button fx:id="confirmerButton" text="Pay"
                    onAction="#ajouterPaiement"
                    styleClass="modern-btn"/>

            <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>
        </VBox>
    </center>



</BorderPane>
