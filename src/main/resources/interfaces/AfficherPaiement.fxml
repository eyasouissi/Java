<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.AfficherPaiement"
            prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #F5F0FF; -fx-padding: 20;">
    <children>
        <VBox spacing="20" layoutX="20" layoutY="10" prefWidth="960">
            <!-- Titre principal -->
            <Label text="💳 Liste des Paiements"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #4A235A; -fx-font-family: 'Arial'; -fx-text-alignment: center;" />

            <!-- Barre de recherche et tri -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="🔍 Rechercher :"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A235A;" />
                <TextField fx:id="searchField" promptText="Entrez un nom d'utilisateur"
                           prefWidth="250" style="-fx-background-color: #FFFFFF; -fx-border-radius: 10px; -fx-border-color: #E0E0E0; -fx-padding: 5 10 5 10;" />
                <Label text="🔽 Trier par :"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #4A235A;" />
                <ComboBox fx:id="sortComboBox" promptText="Choisir une option"
                          prefWidth="200" style="-fx-background-color: #FFFFFF; -fx-border-radius: 10px; -fx-border-color: #E0E0E0; -fx-padding: 5 10 5 10;"/>
            </HBox>

            <!-- Tableau des paiements -->
            <TableView fx:id="tablePaiements" prefHeight="460.0" prefWidth="960.0" style="-fx-background-color: #FFFFFF; -fx-border-radius: 10px;">
                <columns>
                    <TableColumn fx:id="colUser" text="Utilisateur" prefWidth="180"/>
                    <TableColumn fx:id="colOffre" text="Offre" prefWidth="180"/>
                    <TableColumn fx:id="colDate" text="Date de Paiement" prefWidth="180"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="120"/>
                </columns>
            </TableView>

            <!-- Boutons -->
            <HBox spacing="20" alignment="CENTER_RIGHT">
                <Button fx:id="btnExporterPDF" text="📄 Exporter en PDF"
                        style="-fx-background-color: #4A235A; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5px;"
                        onAction="#exporterPDF" />
                <Button fx:id="btnRetourOffres" text="🔙 Retour aux Offres"
                        style="-fx-background-color: #4A235A; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-border-radius: 5px;"
                        onAction="#allerVersOffres"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
