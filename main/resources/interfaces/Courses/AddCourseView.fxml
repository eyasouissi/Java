<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/11.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.Courses.AddCourseController"
      spacing="20"
      alignment="TOP_CENTER"
      style="-fx-background-color: #f5f7fa; -fx-padding: 25;"
      prefWidth="500">

    <!-- Header with title -->
    <Label text="Nouveau cours"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator style="-fx-padding: 0 0 10 0;"/>

    <!-- Form in a shadowed panel -->
    <GridPane hgap="15" vgap="15"
              style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
        </columnConstraints>

        <!-- Title Field -->
        <Label text="Titre*:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="Entrez le titre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="titleError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
               GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.valignment="BOTTOM"/>

        <!-- Description Field -->
        <Label text="Description*:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField" promptText="Description du cours" wrapText="true" prefRowCount="3"
                  GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.valignment="TOP"/>
        <Label fx:id="descriptionError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
               GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.valignment="BOTTOM"/>

        <!-- Category Field -->
        <Label text="Catégorie*:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="categoryError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
               GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.valignment="BOTTOM"/>

        <!-- Points Field -->
        <Label text="Points requis*:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="pointsField" promptText="0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label fx:id="pointsError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
               GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.valignment="BOTTOM"/>

        <!-- Premium Checkbox -->
        <Label text="Premium:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="premiumCheckBox" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Tutor Field -->
        <Label text="Nom du tuteur*:" style="-fx-text-fill: #34495e;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="tutorField" promptText="Nom du formateur" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label fx:id="tutorError" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"
               GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.valignment="BOTTOM"/>
    </GridPane>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Annuler" onAction="#cancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-min-width: 100; -fx-cursor: hand;"/>
        <Button text="Enregistrer" onAction="#saveCourse"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-min-width: 120; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <!-- Required fields note -->
    <Label text="* Champs obligatoires" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px; -fx-padding: 10 0 0 0;"/>
</VBox>