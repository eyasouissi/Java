<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.AjouterPaiement"
            stylesheets="@/css/style.css"
            prefWidth="600" prefHeight="500"
            style="-fx-background-color: #f3e8ff;">

    <!-- Header -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header-bar" style="-fx-padding: 10;">
            <Label text="🏠 Mentor" styleClass="header-title" />
            <Button text="Accueil" onAction="#goHome" styleClass="header-button"/>
            <Button text="Offres" onAction="#goOffres" styleClass="header-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="profileBtn" text="Profil" styleClass="btn-getstarted"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
            <Label text="💳 Paiement de l'Offre" styleClass="section-title"/>
            <Label fx:id="offreLabel" styleClass="paiement-label"/>
            <Label fx:id="prixLabel" styleClass="paiement-subtitle"/>

            <ComboBox fx:id="userComboBox" promptText="Sélectionner un utilisateur"
                      prefWidth="300" styleClass="custom-field"/>

            <DatePicker fx:id="datePaiementPicker" promptText="Date du paiement"
                        prefWidth="300" styleClass="custom-field"/>

            <!-- Le bouton corrigé : ajout de fx:id -->
            <Button fx:id="confirmerButton" text="payer"
                    onAction="#ajouterPaiement"
                    styleClass="modern-btn"/>

            <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <VBox alignment="CENTER" styleClass="footer-bar" style="-fx-padding: 10;">
            <Label text="© Mentor - Tous droits réservés." />
        </VBox>
    </bottom>
</BorderPane>
